async def edit_and_send_image(
    update: Update,
    image_bytes: bytes,
    prompt: str,
) -> None:
    if not update.message:
        return

    image_file = io.BytesIO(image_bytes)
    image_file.name = "telegram_image.jpg"
    image_file.seek(0)

    result = await openai_client.images.edit(
        model=IMAGE_EDIT_MODEL,
        image=image_file,
        prompt=prompt,
        quality="medium",
        output_format="png",
    )

    if not result.data or not result.data[0].b64_json:
        raise RuntimeError("Image API did not return image data")

    edited_bytes = base64.b64decode(
        result.data[0].b64_json
    )

    edited_file = io.BytesIO(edited_bytes)
    edited_file.name = "armenia_helper_edited.png"
    edited_file.seek(0)

    await update.message.reply_photo(
        photo=edited_file,
        caption="🖼 Готово. Изображение отредактировано ИИ.",
    )


