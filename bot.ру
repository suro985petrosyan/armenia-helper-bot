async def send_voice_reply(
    update: Update,
    text: str,
) -> None:
    if not update.message or not text:
        return

    # Telegram voice messages удобнее всего отправлять в OGG/Opus.
    speech = await openai_client.audio.speech.create(
        model=VOICE_TTS_MODEL,
        voice=VOICE_TTS_VOICE,
        input=text,
        response_format="opus",
    )

    audio_bytes = speech.content
    voice_buffer = io.BytesIO(audio_bytes)
    voice_buffer.name = "armenia_helper_reply.ogg"
    voice_buffer.seek(0)

    await update.message.reply_voice(
        voice=voice_buffer,
        caption="🔊 Голосовой ответ сгенерирован ИИ.",
    )


async def voice_message(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
) -> None:
    if (
        not update.effective_user
        or not update.effective_chat
        or not update.message
    ):
        return

    media = update.message.voice or update.message.audio

    if not media:
        return

    duration = getattr(media, "duration", 0) or 0

    if duration > 300:
        await update.message.reply_text(
            "Голосовое слишком длинное. "
            "Пожалуйста, отправьте запись до 5 минут."
        )
        return

    await context.bot.send_chat_action(
        chat_id=update.effective_chat.id,
        action=ChatAction.TYPING,
    )

    try:
        telegram_file = await context.bot.get_file(
            media.file_id
        )

        audio_buffer = io.BytesIO()
        await telegram_file.download_to_memory(
            out=audio_buffer
        )
        audio_buffer.seek(0)
        audio_buffer.name = "telegram_voice.ogg"

        transcription = (
            await openai_client.audio.transcriptions.create(
                model=VOICE_TRANSCRIPTION_MODEL,
                file=audio_buffer,
            )
        )

        transcript = (
            getattr(transcription, "text", "") or ""
        ).strip()

        if not transcript:
            await update.message.reply_text(
                "Не удалось распознать голосовое. "
                "Попробуйте записать его ещё раз."
            )
            return

        await answer_user_text(
            update,
            context,
            transcript,
            reply_with_voice=True,
        )

    except Exception as error:
        logger.exception(
            "Ошибка при обработке голосового: %s",
            error,
        )

        await update.message.reply_text(
            "Не удалось обработать голосовое. "
            "Попробуйте ещё раз немного позже."
        )



