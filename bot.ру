    )

    payment_is_valid = (
        payment.invoice_payload == expected_payload
        and payment.currency == "XTR"
        and payment.total_amount
        == PREMIUM_PRICE_STARS
    )

    if not payment_is_valid:
        logger.error(
            "Получен платёж "
            "с неверными параметрами"
        )
        return

    premium_until = (
        payment.subscription_expiration_date
    )

    if premium_until is None:
        premium_until = (
            datetime.now(timezone.utc)
            + timedelta(days=30)
        )

    pool = get_pool(context)

    await register_user(
        pool,
        update.effective_user,
    )

    async with pool.acquire() as connection:
        async with connection.transaction():
            await connection.execute(
                """
                INSERT INTO payments (
                    telegram_payment_charge_id,
                    telegram_id,
                    amount,
                    currency,
                    subscription_expiration_date
                )
                VALUES ($1, $2, $3, $4, $5)
                ON CONFLICT (
                    telegram_payment_charge_id
                )
                DO NOTHING
                """,
                payment.telegram_payment_charge_id,
                update.effective_user.id,
                payment.total_amount,
                payment.currency,
                premium_until,
            )

            await connection.execute(
                """
                UPDATE users
                SET
                    premium_until = GREATEST(
                        COALESCE(
                            premium_until,
                            TIMESTAMPTZ
                            '1970-01-01 00:00:00+00'
                        ),
                        $2
                    ),
                    telegram_payment_charge_id = $3,
                    updated_at = NOW()
                WHERE telegram_id = $1
                """,
                update.effective_user.id,
                premium_until,
                payment.telegram_payment_charge_id,
            )

    local_until = premium_until.astimezone(
        ARMENIA_TIME
    )

    await update.message.reply_text(
        "Оплата получена ✅\n\n"
        f"Premium активирован до "
        f"{local_until:%d.%m.%Y %H:%M} "
        "по Еревану.\n"
        f"Теперь доступно "
        f"{PREMIUM_DAILY_LIMIT} запросов в день."
    )


async def send_long_message(
    update: Update,
    text: str,
) -> None:
    if not update.message:
        return

    max_length = 4000

    for index in range(
        0,
        len(text),
        max_length,
    ):
        await update.message.reply_text(
            text[index:index + max_length]
        )


