import os
import logging

from openai import AsyncOpenAI
from telegram import Update
from telegram.constants import ChatAction
from telegram.ext import (
    Application,
    CommandHandler,
    ContextTypes,
    MessageHandler,
    filters,
)


# Получаем секретные ключи из переменных окружения
TELEGRAM_BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")

if not TELEGRAM_BOT_TOKEN:
    raise ValueError("Не найден TELEGRAM_BOT_TOKEN")

if not OPENAI_API_KEY:
    raise ValueError("Не найден OPENAI_API_KEY")


# Подключение OpenAI
openai_client = AsyncOpenAI(api_key=OPENAI_API_KEY)

# Память диалога каждого пользователя
user_response_ids = {}

# Настройка журнала ошибок
logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    level=logging.INFO,
)

logger = logging.getLogger(__name__)


ASSISTANT_INSTRUCTIONS = """
Ты — умный онлайн-помощник для пользователей из Армении.

Твои задачи:
- отвечать на вопросы;
- переводить между русским, армянским и английским языками;
- помогать составлять тексты, объявления и документы;
- помогать с бизнес-идеями и повседневными задачами;
- объяснять сложные вещи простыми словами.

Определи язык пользователя и отвечай на том же языке.
Пиши понятно, доброжелательно и без лишней воды.
Если не уверен в информации, честно сообщи об этом.
Не обещай выполнить действия, которые не можешь выполнить.
"""


async def start(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
) -> None:
    """Команда /start."""

    if not update.effective_user or not update.message:
        return

    user_response_ids.pop(update.effective_user.id, None)

    text = (
        "Здравствуйте! 👋\n\n"
        "Я ваш умный помощник.\n"
        "Можете написать мне вопрос на русском, "
        "армянском или английском языке.\n\n"
        "Для очистки истории используйте команду /new."
    )

    await update.message.reply_text(text)


async def new_dialog(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
) -> None:
    """Команда /new очищает память диалога."""

    if not update.effective_user or not update.message:
        return

    user_response_ids.pop(update.effective_user.id, None)

    await update.message.reply_text(
        "История очищена. Можете начать новый разговор ✅"
    )


async def send_long_message(
    update: Update,
    text: str,
) -> None:
    """Разделяет длинный ответ на части."""

    if not update.message:
        return

    max_length = 4000

    for start_index in range(0, len(text), max_length):
        part = text[start_index:start_index + max_length]
        await update.message.reply_text(part)


async def answer_message(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
) -> None:
    """Получает сообщение пользователя и отправляет его в OpenAI."""

    if (
        not update.effective_user
        or not update.message
        or not update.message.text
    ):
        return

    user_id = update.effective_user.id
    user_text = update.message.text

    await context.bot.send_chat_action(
        chat_id=update.effective_chat.id,
        action=ChatAction.TYPING,
    )

    try:
        request_data = {
            "model": "gpt-5.6",
            "instructions": ASSISTANT_INSTRUCTIONS,
            "input": user_text,
        }

        # Продолжаем предыдущий разговор пользователя
        previous_response_id = user_response_ids.get(user_id)

        if previous_response_id:
            request_data["previous_response_id"] = previous_response_id

        response = await openai_client.responses.create(**request_data)

        # Сохраняем идентификатор ответа для продолжения разговора
        user_response_ids[user_id] = response.id

        answer = response.output_text

        if not answer:
            answer = "Не удалось сформировать ответ. Попробуйте ещё раз."

        await send_long_message(update, answer)

    except Exception as error:
        logger.exception("Ошибка при обработке сообщения: %s", error)

        await update.message.reply_text(
            "Произошла ошибка. Попробуйте написать ещё раз немного позже."
        )


async def error_handler(
    update: object,
    context: ContextTypes.DEFAULT_TYPE,
) -> None:
    logger.exception(
        "Ошибка Telegram-бота:",
        exc_info=context.error,
    )


def main() -> None:
    """Запуск Telegram-бота."""

    application = (
        Application.builder()
        .token(TELEGRAM_BOT_TOKEN)
        .build()
    )

    application.add_handler(CommandHandler("start", start))
    application.add_handler(CommandHandler("new", new_dialog))

    application.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            answer_message,
        )
    )

    application.add_error_handler(error_handler)

    print("Бот запущен!")

    application.run_polling(
        allowed_updates=Update.ALL_TYPES
    )


if __name__ == "__main__":
    main()
