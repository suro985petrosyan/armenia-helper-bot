    )

    await pool.execute(
        """
        CREATE TABLE IF NOT EXISTS payments (
            telegram_payment_charge_id
                TEXT PRIMARY KEY,
            telegram_id BIGINT
                NOT NULL
                REFERENCES users(telegram_id),
            amount INTEGER NOT NULL,
            currency TEXT NOT NULL,
            subscription_expiration_date
                TIMESTAMPTZ,
            paid_at TIMESTAMPTZ
                NOT NULL DEFAULT NOW()
