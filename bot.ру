async def precheckout_callback(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
) -> None:
    query = update.pre_checkout_query

    if not query:
        return

    expected_payload = (
        f"{PAYLOAD_PREFIX}:{query.from_user.id}"
    )

    payment_is_valid = (
        query.invoice_payload == expected_payload
        and query.currency == "XTR"
        and query.total_amount
        == PREMIUM_PRICE_STARS
    )

    if payment_is_valid:
        await query.answer(ok=True)
    else:
        await query.answer(
            ok=False,
            error_message=(
                "Создайте новый счёт "
                "командой /premium."
            ),
        )


