def get_pool(
    context: ContextTypes.DEFAULT_TYPE,
) -> asyncpg.Pool:
    return context.application.bot_data["db_pool"]


async def register_user(
    pool: asyncpg.Pool,
    user,
) -> None:
    await pool.execute(
        """
        INSERT INTO users (
            telegram_id,
            username,
            first_name,
            count_date
        )
        VALUES (
            $1,
            $2,
            $3,
            (NOW() AT TIME ZONE 'Asia/Yerevan')::date
        )
        ON CONFLICT (telegram_id) DO UPDATE SET
            username = EXCLUDED.username,
            first_name = EXCLUDED.first_name,
            updated_at = NOW()
        """,
        user.id,
        user.username,
        user.first_name,
    )


async def get_user_status(
    pool: asyncpg.Pool,
    user,
) -> dict:
    await register_user(pool, user)

    # Обнуляем дневной счётчик после наступления нового дня в Ереване
    await pool.execute(
        """
        UPDATE users
        SET
            daily_count = 0,
            image_edit_count = 0,
            web_search_count = 0,
            count_date =
                (NOW() AT TIME ZONE 'Asia/Yerevan')::date,
            updated_at = NOW()
        WHERE telegram_id = $1
          AND count_date <>
              (NOW() AT TIME ZONE 'Asia/Yerevan')::date
        """,
        user.id,
    )

    row = await pool.fetchrow(
        """
        SELECT
            daily_count,
            premium_until,
            COALESCE(
                premium_until > NOW(),
                FALSE
            ) AS is_premium
        FROM users
        WHERE telegram_id = $1
        """,
        user.id,
    )

    return dict(row)


async def consume_request(
    pool: asyncpg.Pool,
    user,
) -> tuple[bool, int, int]:
    await register_user(pool, user)

    # Администратор может тестировать бота без дневного лимита.
    if user.id == ADMIN_TELEGRAM_ID:
        return True, 0, 999999

    async with pool.acquire() as connection:
        async with connection.transaction():
            row = await connection.fetchrow(
                """
                SELECT
                    daily_count,
                    count_date,
                    COALESCE(
                        premium_until > NOW(),
                        FALSE
                    ) AS is_premium
                FROM users
                WHERE telegram_id = $1
                FOR UPDATE
                """,
                user.id,
            )

            today = await connection.fetchval(
                """
                SELECT
                    (NOW() AT TIME ZONE 'Asia/Yerevan')::date
                """
            )

            used = row["daily_count"]

            if row["count_date"] != today:
                used = 0

                await connection.execute(
                    """
                    UPDATE users
                    SET
                        daily_count = 0,
                        image_edit_count = 0,
                        web_search_count = 0,
                        count_date = $2,
                        updated_at = NOW()
                    WHERE telegram_id = $1
                    """,
                    user.id,
                    today,
                )

            if row["is_premium"]:
                limit = PREMIUM_DAILY_LIMIT
            else:
                limit = FREE_DAILY_LIMIT

            if used >= limit:
                return False, used, limit

            used += 1

            await connection.execute(
                """
                UPDATE users
                SET
                    daily_count = $2,
                    updated_at = NOW()
                WHERE telegram_id = $1
                """,
                user.id,
                used,
            )

            return True, used, limit


async def restore_request(
    pool: asyncpg.Pool,
    telegram_id: int,
) -> None:
    """Возвращает запрос, если OpenAI ответил ошибкой."""

    await pool.execute(
        """
        UPDATE users
        SET
            daily_count =
                GREATEST(daily_count - 1, 0),
            updated_at = NOW()
        WHERE telegram_id = $1
          AND count_date =
              (NOW() AT TIME ZONE 'Asia/Yerevan')::date
        """,
        telegram_id,
    )


async def consume_feature(
    pool: asyncpg.Pool,
    user,
    feature: str,
) -> tuple[bool, int, int]:
    await register_user(pool, user)

    if user.id == ADMIN_TELEGRAM_ID:
        return True, 0, 999999

    if feature not in {"image_edit", "web_search"}:
        raise ValueError("Неизвестная функция")

    column = (
        "image_edit_count"
        if feature == "image_edit"
        else "web_search_count"
    )

    async with pool.acquire() as connection:
        async with connection.transaction():
            row = await connection.fetchrow(
                f"""
                SELECT
                    {column} AS used,
                    count_date,
                    COALESCE(
                        premium_until > NOW(),
                        FALSE
                    ) AS is_premium
                FROM users
                WHERE telegram_id = $1
                FOR UPDATE
                """,
                user.id,
            )

            today = await connection.fetchval(
                """
                SELECT
                    (NOW() AT TIME ZONE 'Asia/Yerevan')::date
                """
            )

            used = row["used"]

            if row["count_date"] != today:
                used = 0
                await connection.execute(
                    """
                    UPDATE users
                    SET
                        daily_count = 0,
                        image_edit_count = 0,
                        web_search_count = 0,
                        count_date = $2,
                        updated_at = NOW()
                    WHERE telegram_id = $1
                    """,
                    user.id,
                    today,
                )

            if feature == "image_edit":
                limit = (
                    PREMIUM_IMAGE_EDIT_DAILY_LIMIT
                    if row["is_premium"]
                    else FREE_IMAGE_EDIT_DAILY_LIMIT
                )
            else:
                limit = (
                    PREMIUM_WEB_SEARCH_DAILY_LIMIT
                    if row["is_premium"]
                    else FREE_WEB_SEARCH_DAILY_LIMIT
                )

            if used >= limit:
                return False, used, limit

            used += 1

            await connection.execute(
                f"""
                UPDATE users
                SET
                    {column} = $2,
                    updated_at = NOW()
                WHERE telegram_id = $1
                """,
                user.id,
                used,
            )

            return True, used, limit


