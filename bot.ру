            "запросов сегодня.\n\n"
            f"Premium даёт "
            f"{PREMIUM_DAILY_LIMIT} "
            "запросов в день.",
            reply_markup=keyboard,
        )
        return

    await context.bot.send_chat_action(
        chat_id=update.effective_chat.id,
        action=ChatAction.TYPING,
    )

    try:
        # Берём самое большое доступное изображение из Telegram.
        photo = update.message.photo[-1]
        telegram_file = await context.bot.get_file(
            photo.file_id
        )

        image_buffer = io.BytesIO()
        await telegram_file.download_to_memory(
            out=image_buffer
        )
        image_bytes = image_buffer.getvalue()

        image_b64 = base64.b64encode(
            image_bytes
        ).decode("ascii")

        user_prompt = (
            update.message.caption or
            "Проанализируй это изображение и объясни, "
            "что на нём изображено. Если есть текст, "
            "прочитай и объясни его. Если вопрос зависит "
            "от страны или локального контекста, ориентируйся "
            "на Армению, если пользователь не указал другое."
        )

        request_data = {
            "model": OPENAI_MODEL,
            "instructions": ASSISTANT_INSTRUCTIONS,
            "input": [
                {
                    "role": "user",
                    "content": [
                        {
                            "type": "input_text",
                            "text": user_prompt,
                        },
                        {
                            "type": "input_image",
                            "image_url": (
                                "data:image/jpeg;base64,"
                                + image_b64
                            ),
                            "detail": "auto",
                        },
                    ],
                }
            ],
            "reasoning": {
                "effort": "low",
            },
            "max_output_tokens": 1200,
        }

        previous_response_id = (
            user_response_ids.get(user.id)
        )

        if previous_response_id:
            request_data[
                "previous_response_id"
            ] = previous_response_id

        response = (
            await openai_client.responses.create(
                **request_data
            )
        )

        user_response_ids[user.id] = response.id

        answer = response.output_text

        if not answer:
            answer = (
                "Не удалось проанализировать изображение. "
                "Попробуйте отправить его ещё раз."
            )

        await send_long_message(
            update,
            answer,
        )

    except Exception as error:
        await restore_request(
            pool,
            user.id,
        )

        logger.exception(
            "Ошибка при обработке изображения: %s",
            error,
        )

        await update.message.reply_text(
            "Не удалось обработать изображение. "
            "Попробуйте отправить его ещё раз немного позже."
        )


async def post_init(
    application: Application,
) -> None:
    pool = await asyncpg.create_pool(
        DATABASE_URL,
        min_size=1,
        max_size=5,
        command_timeout=30,
    )

    application.bot_data["db_pool"] = pool

    await pool.execute(
        """
        CREATE TABLE IF NOT EXISTS users (
            telegram_id BIGINT PRIMARY KEY,
            username TEXT,
            first_name TEXT,
            premium_until TIMESTAMPTZ,
            daily_count INTEGER
                NOT NULL DEFAULT 0,
            count_date DATE
                NOT NULL DEFAULT CURRENT_DATE,
            telegram_payment_charge_id TEXT,
            created_at TIMESTAMPTZ
                NOT NULL DEFAULT NOW(),
            updated_at TIMESTAMPTZ
                NOT NULL DEFAULT NOW()
        )
        """
    )

    await pool.execute(
        """
        CREATE TABLE IF NOT EXISTS payments (
            telegram_payment_charge_id
                TEXT PRIMARY KEY,
            telegram_id BIGINT
                NOT NULL
                REFERENCES users(telegram_id),
            amount INTEGER NOT NULL,
            currency TEXT NOT NULL,
            subscription_expiration_date
                TIMESTAMPTZ,
            paid_at TIMESTAMPTZ
                NOT NULL DEFAULT NOW()
        )
        """
    )

    await application.bot.set_my_commands(
        [
            BotCommand(
                "start",
                "Запустить бота",
            ),
            BotCommand(
                "new",
                "Начать новый разговор",
            ),
            BotCommand(
                "status",
                "Мой тариф и лимит",
            ),
            BotCommand(
                "premium",
                "Подключить Premium",
            ),
        ]
    )

    logger.info(
        "База данных подключена, "
        "бот готов к работе"
    )


async def post_shutdown(
    application: Application,
) -> None:
    pool = application.bot_data.get(
        "db_pool"
    )

    if pool:
        await pool.close()


async def error_handler(
    update: object,
    context: ContextTypes.DEFAULT_TYPE,
) -> None:
    logger.exception(
        "Ошибка Telegram-бота:",
        exc_info=context.error,
    )


def main() -> None:
    application = (
        Application.builder()
        .token(TELEGRAM_BOT_TOKEN)
        .post_init(post_init)
        .post_shutdown(post_shutdown)
        .build()
    )

    application.add_handler(
        CommandHandler(
            "start",
            start,
        )
    )

    application.add_handler(
        CommandHandler(
            "new",
            new_dialog,
        )
    )

    application.add_handler(
        CommandHandler(
            "status",
            status_command,
        )
    )

    application.add_handler(
        CommandHandler(
            "premium",
            premium_command,
        )
    )

    application.add_handler(
        PreCheckoutQueryHandler(
            precheckout_callback
        )
    )

    application.add_handler(
        MessageHandler(
            filters.SUCCESSFUL_PAYMENT,
            successful_payment_callback,
        )
    )

    application.add_handler(
        MessageHandler(
            filters.PHOTO,
            image_message,
        )
    )

    application.add_handler(
        MessageHandler(
            filters.VOICE | filters.AUDIO,
            voice_message,
        )
    )

    application.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            answer_message,
        )
    )

    application.add_error_handler(
        error_handler
    )

    print("Бот запущен!")

    application.run_polling(
        allowed_updates=Update.ALL_TYPES
    )


if __name__ == "__main__":
    main()
