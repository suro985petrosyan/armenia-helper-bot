async def precheckout_callback(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
) -> None:
    query = update.pre_checkout_query

    if not query:
        return

    expected_payload = (
        f"{PAYLOAD_PREFIX}:{query.from_user.id}"
    )

    payment_is_valid = (
        query.invoice_payload == expected_payload
        and query.currency == "XTR"
        and query.total_amount
        == PREMIUM_PRICE_STARS
    )

    if payment_is_valid:
        await query.answer(ok=True)
    else:
        await query.answer(
            ok=False,
            error_message=(
                "Создайте новый счёт "
                "командой /premium."
            ),
        )


async def successful_payment_callback(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
) -> None:
    if (
        not update.effective_user
        or not update.message
    ):
        return

    payment = update.message.successful_payment

    if not payment:
        return

    expected_payload = (
        f"{PAYLOAD_PREFIX}:"
        f"{update.effective_user.id}"
    )

    payment_is_valid = (
        payment.invoice_payload == expected_payload
        and payment.currency == "XTR"
        and payment.total_amount
        == PREMIUM_PRICE_STARS
    )

    if not payment_is_valid:
        logger.error(
            "Получен платёж "
            "с неверными параметрами"
        )
        return

    premium_until = (
        payment.subscription_expiration_date
    )

    if premium_until is None:
        premium_until = (
            datetime.now(timezone.utc)
            + timedelta(days=30)
        )

    pool = get_pool(context)

    await register_user(
        pool,
        update.effective_user,
    )

    async with pool.acquire() as connection:
        async with connection.transaction():
            await connection.execute(
                """
                INSERT INTO payments (
                    telegram_payment_charge_id,
                    telegram_id,
                    amount,
                    currency,
                    subscription_expiration_date
                )
                VALUES ($1, $2, $3, $4, $5)
                ON CONFLICT (
                    telegram_payment_charge_id
                )
                DO NOTHING
                """,
                payment.telegram_payment_charge_id,
                update.effective_user.id,
                payment.total_amount,
                payment.currency,
                premium_until,
            )

            await connection.execute(
                """
                UPDATE users
                SET
                    premium_until = GREATEST(
                        COALESCE(
                            premium_until,
                            TIMESTAMPTZ
                            '1970-01-01 00:00:00+00'
                        ),
                        $2
                    ),
                    telegram_payment_charge_id = $3,
                    updated_at = NOW()
                WHERE telegram_id = $1
                """,
                update.effective_user.id,
                premium_until,
                payment.telegram_payment_charge_id,
            )

    local_until = premium_until.astimezone(
        ARMENIA_TIME
    )

    await update.message.reply_text(
        "Оплата получена ✅\n\n"
        f"Premium активирован до "
        f"{local_until:%d.%m.%Y %H:%M} "
        "по Еревану.\n"
        f"Теперь доступно "
        f"{PREMIUM_DAILY_LIMIT} запросов в день."
    )


async def send_long_message(
    update: Update,
    text: str,
) -> None:
    if not update.message:
        return

    max_length = 4000

    for index in range(
        0,
        len(text),
        max_length,
    ):
        await update.message.reply_text(
            text[index:index + max_length]
        )


async def answer_user_text(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
    text: str,
    reply_with_voice: bool = False,
) -> None:
    if (
        not update.effective_user
        or not update.effective_chat
        or not update.message
    ):
        return

    user = update.effective_user
    pool = get_pool(context)

    allowed, used, limit = await consume_request(
        pool,
        user,
    )

    if not allowed:
        keyboard = await premium_keyboard(
            context,
            user.id,
        )

        await update.message.reply_text(
            f"Лимит закончился: "
            f"{used} из {limit} "
            "запросов сегодня.\n\n"
            f"Premium даёт "
            f"{PREMIUM_DAILY_LIMIT} "
            "запросов в день.",
            reply_markup=keyboard,
        )
        return

    await context.bot.send_chat_action(
        chat_id=update.effective_chat.id,
        action=ChatAction.TYPING,
    )

    try:
        request_data = {
            "model": OPENAI_MODEL,
            "instructions": (
                ASSISTANT_INSTRUCTIONS
            ),
            "input": text,
            "reasoning": {
                "effort": "low",
            },
            "max_output_tokens": 1200,
        }

        previous_response_id = (
            user_response_ids.get(user.id)
        )

        if previous_response_id:
            request_data[
                "previous_response_id"
            ] = previous_response_id

        response = (
            await openai_client.responses.create(
                **request_data
            )
        )

        user_response_ids[user.id] = response.id

        answer = response.output_text

        if not answer:
            answer = (
                "Не удалось сформировать ответ. "
                "Попробуйте ещё раз."
            )

        await send_long_message(
            update,
            answer,
        )

        if reply_with_voice:
            try:
                await send_voice_reply(
                    update,
                    answer,
                )
            except Exception as voice_error:
                # Текстовый ответ уже доставлен, поэтому ошибка озвучки
                # не должна списывать пользователю запрос повторно.
                logger.exception(
                    "Ошибка при озвучивании ответа: %s",
                    voice_error,
                )
                await update.message.reply_text(
                    "Текстовый ответ готов, но сейчас "
                    "не получилось отправить его голосом."
                )

    except Exception as error:
        await restore_request(
            pool,
            user.id,
        )

        logger.exception(
            "Ошибка при обработке сообщения: %s",
            error,
        )

        await update.message.reply_text(
            "Произошла ошибка. "
            "Попробуйте написать ещё раз "
            "немного позже."
        )


