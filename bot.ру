async def maybe_consume_web_search(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
    text: str,
) -> tuple[bool, bool]:
    """Returns (may_continue, use_web_search)."""
    if not update.effective_user:
        return True, False

    if not needs_web_search(text):
        return True, False

    pool = get_pool(context)
    allowed, used, limit = await consume_feature(
        pool,
        update.effective_user,
        "web_search",
    )

    if allowed:
        return True, True

    keyboard = await premium_keyboard(
        context,
        update.effective_user.id,
    )

    await update.message.reply_text(
        "🌐 Лимит актуального интернет-поиска на сегодня "
        f"использован: {used} из {limit}.\\n\\n"
        f"⭐ Premium даёт до {PREMIUM_WEB_SEARCH_DAILY_LIMIT} "
        "интернет-поисков в день.",
        reply_markup=keyboard,
    )
    return False, False


async def answer_user_text(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
    text: str,
    reply_with_voice: bool = False,
) -> None:
    if (
        not update.effective_user
        or not update.effective_chat
        or not update.message
    ):
        return

    user = update.effective_user
    pool = get_pool(context)

    allowed, used, limit = await consume_request(
        pool,
        user,
    )

    if not allowed:
        keyboard = await premium_keyboard(
            context,
            user.id,
        )

        await update.message.reply_text(
            f"Лимит закончился: "
            f"{used} из {limit} "
            "запросов сегодня.\n\n"
            f"Premium даёт "
            f"{PREMIUM_DAILY_LIMIT} "
            "запросов в день.",
            reply_markup=keyboard,
        )
        return

    await context.bot.send_chat_action(
        chat_id=update.effective_chat.id,
        action=ChatAction.TYPING,
    )

    try:
        may_continue, use_web_search = (
            await maybe_consume_web_search(
                update,
                context,
                text,
            )
        )

        if not may_continue:
            await restore_request(
                pool,
                user.id,
            )
            return

        request_data = {
            "model": OPENAI_MODEL,
            "instructions": (
                ASSISTANT_INSTRUCTIONS
            ),
            "input": text,
            "reasoning": {
                "effort": "low",
            },
            "max_output_tokens": 1200,
        }

        if use_web_search:
            request_data["tools"] = [
                {"type": "web_search"}
            ]

        previous_response_id = (
            user_response_ids.get(user.id)
        )

        if previous_response_id:
            request_data[
                "previous_response_id"
            ] = previous_response_id

        response = (
            await openai_client.responses.create(
                **request_data
            )
        )

        user_response_ids[user.id] = response.id

        answer = response.output_text

        if not answer:
            answer = (
                "Не удалось сформировать ответ. "
                "Попробуйте ещё раз."
            )

        await send_long_message(
            update,
            answer,
        )

        if reply_with_voice:
            try:
                await send_voice_reply(
                    update,
                    answer,
                )
            except Exception as voice_error:
                # Текстовый ответ уже доставлен, поэтому ошибка озвучки
                # не должна списывать пользователю запрос повторно.
                logger.exception(
                    "Ошибка при озвучивании ответа: %s",
                    voice_error,
                )
                await update.message.reply_text(
                    "Текстовый ответ готов, но сейчас "
                    "не получилось отправить его голосом."
                )

    except Exception as error:
        await restore_request(
            pool,
            user.id,
        )

        logger.exception(
            "Ошибка при обработке сообщения: %s",
            error,
        )

        await update.message.reply_text(
            "Произошла ошибка. "
            "Попробуйте написать ещё раз "
            "немного позже."
        )



def is_confirmation(text: str) -> bool:
    normalized = (text or "").strip().lower()
    return normalized in {
        "да", "давай", "сделай", "ок", "окей", "хорошо",
        "yes", "do it", "այո", "արա",
    }


async def try_edit_last_image_from_text(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
    text: str,
) -> bool:
    if not update.effective_user or not update.message:
        return False

    user = update.effective_user
    image_bytes = user_last_images.get(user.id)
    if not image_bytes:
        return False

    edit_prompt = None
    if wants_image_edit(text):
        edit_prompt = text
        user_pending_image_edits[user.id] = text
    elif is_confirmation(text):
        edit_prompt = user_pending_image_edits.get(user.id)

        if not edit_prompt:
            await update.message.reply_text(
                "Фото у меня есть 👍 Напишите, что именно изменить, "
                "например: «улучши фото», «убери фон», "
                "«сделай мультяшным» или «удали человека»."
            )
            return True

    if not edit_prompt:
        return False

    pool = get_pool(context)
    allowed, used, limit = await consume_feature(
        pool, user, "image_edit"
    )

    if not allowed:
        keyboard = await premium_keyboard(context, user.id)
        await update.message.reply_text(
            f"Лимит редактирования фото: {used} из {limit} сегодня.\\n\\n"
            f"⭐ Premium даёт до {PREMIUM_IMAGE_EDIT_DAILY_LIMIT} "
            "редактирований изображений в день.",
            reply_markup=keyboard,
        )
        return True

    await context.bot.send_chat_action(
        chat_id=update.effective_chat.id,
        action=ChatAction.UPLOAD_PHOTO,
    )

    try:
        await edit_and_send_image(update, image_bytes, edit_prompt)
        user_pending_image_edits.pop(user.id, None)
    except Exception as error:
        logger.exception("Ошибка редактирования последнего фото: %s", error)
        await update.message.reply_text(
            "Не получилось отредактировать фото. Попробуйте ещё раз."
        )
    return True


async def answer_message(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
) -> None:
    if (
        not update.message
        or not update.message.text
    ):
        return

    text = update.message.text

